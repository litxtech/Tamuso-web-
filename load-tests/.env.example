# Tamuso Load Tests — güvenlik kapısı kapalıyken production'a otomatik yük basılmaz.
# Bkz. README.md

LOADTEST_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
LOADTEST_SUPABASE_ANON_KEY=sb_publishable_xxx

# Ortam etiketi: staging | production
LOADTEST_ENV=staging

# Production READ smoke için açık onay (yoksa k6 abort)
# LOADTEST_ALLOW_PROD_READ=1

# WRITE testleri (like/follow) — yalnızca staging + açık onay
# LOADTEST_ALLOW_WRITE=1

# Önceden üretilmiş test JWT listesi (satır başına bir access_token veya JSON)
LOADTEST_TOKENS_FILE=./fixtures/tokens.json

# Test profil UUID havuzu (virgülle veya JSON)
LOADTEST_PROFILE_IDS=

# Varsayılan senaryo: mixed | home | status | profile | messages | follow | leaderboard | notifications | room | auth
LOADTEST_SCENARIO=mixed

# CCU hedefi (stages runner kullanıyorsa)
LOADTEST_CCU=100

# Think-time (saniye, min-max) — Free baseline ile aynı tut: 2–5
LOADTEST_THINK_MIN=2
LOADTEST_THINK_MAX=5

# Hold / ramp — Free baseline: HOLD=180, RAMP=45
LOADTEST_HOLD_SEC=180
LOADTEST_RAMP_SEC=45

# Circuit breaker
LOADTEST_ABORT_P95_MS=5000
LOADTEST_ABORT_FAIL_RATE=0.10
LOADTEST_ABORT_5XX_RATE=0.05

# Immutable Free baseline id (karşılaştırma referansı — üzerine yazma)
# LOADTEST_COMPARE_BASELINE=SUPABASE_FREE_BASELINE_2026-09-23

# Yeni run'lar results/runs/<id>/ altına gider; baseline'a ASLA yazılmaz.
# LOADTEST_RUN_ID=SUPABASE_PRO_AFTER_UPGRADE_2026-10-01
# LOADTEST_RUN_LABEL=post-upgrade
