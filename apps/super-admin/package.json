{
  "name": "tamuso-super-admin",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web --port 8090",
    "build": "expo export --platform web --output-dir dist",
    "serve": "npx --yes serve -s dist -l tcp://127.0.0.1:8091",
    "preview": "npm run build && npm run serve",
    "deploy": "npm run build && node deploy.mjs",
    "typecheck": "tsc --noEmit"
  }
}
