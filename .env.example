EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
EXPO_PUBLIC_APP_NAME=Tamuso
EXPO_PUBLIC_APP_SCHEME=muta
EXPO_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
EXPO_PUBLIC_LIVEKIT_TOKEN_URL=https://YOUR_PROJECT.supabase.co/functions/v1/livekit-token
EXPO_PUBLIC_IAP_VERIFY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/iap-receipt-verify
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/stripe-checkout
# Publishable key only (pk_…). Secret (sk_…) NEVER in mobile env — Dashboard Edge secrets.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# RTC: LiveKit (Agora kaldirildi)
EXPO_PUBLIC_RTC_PROVIDER=livekit
# Opsiyonel: paylaşım / indirme base URL (yoksa share-redirect edge function)
EXPO_PUBLIC_SHARE_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/share-redirect
# Opsiyonel: ajans satış ödeme URL (görünür Tamuso; arka planda ajans-pay). Örn: https://tamuso.app/pay
# Tanımlı değilse: https://YOUR_PROJECT.supabase.co/functions/v1/ajans-pay?c=KOD
EXPO_PUBLIC_PAY_BASE_URL=https://tamuso.app/pay

# EAS: set EXPO_TOKEN in shell or .env.expo.local (never commit)
# EAS_PROJECT_ID=36cb815b-2891-4075-a1a8-89902e491af5

# Edge Function secrets (Dashboard / CLI — never in mobile .env):
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# DEEPSEEK_API_KEY=sk-...   # DeepSeek assistant + live chat translation
# IAP_SKIP_VERIFY=1
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=muta://wallet?stripe=success
# STRIPE_CANCEL_URL=muta://wallet?stripe=cancel
